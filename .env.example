# AeroScout Environment Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=1
DEMO_MODE=1
DEMO_FORCE_CACHED_AI=1

# Storage
DATA_DIR=data
DEMO_DIR=demo

# LLM Provider (Optional live, fallback active by default)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Public Tunnel URL (Populated when tunnel is running for Scout app QR)
PUBLIC_TUNNEL_URL=http://localhost:3000

