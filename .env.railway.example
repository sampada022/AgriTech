# AeroScout — Railway environment variables
# Set these in Railway: Service → Variables

# ── Required ──────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; do not set it manually.

# Demo mode stays on for the hackathon so the seed data is always present.
DEMO_MODE=1
DEMO_FORCE_CACHED_AI=1

# ── Storage ───────────────────────────────────────────────────────────────────
# Match the persistent volume mount path declared in railway.toml / dashboard.
DATA_DIR=/app/data
DEMO_DIR=/app/demo

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replace with your Railway public URL once the service is deployed.
# The website SPA is served by the same FastAPI process, so the site URL IS
# the API URL — you only need one entry here.
# AGRISCOUT_CORS_ORIGINS=https://aeroscout.up.railway.app

# ── Optional LLM (leave blank to use cached demo replies) ────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# ── Security (generate a random 32-byte hex string for production) ────────────
# AGRISCOUT_SECRET=change-me-generate-with-python-secrets-token-hex-32
